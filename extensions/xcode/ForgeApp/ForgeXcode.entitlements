<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <!-- App Sandbox is required for Mac App Store distribution and is strongly
         recommended for all macOS apps. -->
    <key>com.apple.security.app-sandbox</key>
    <true/>

    <!-- Required to reach the local Forge daemon at http://localhost:7878 -->
    <key>com.apple.security.network.client</key>
    <true/>
</dict>
</plist>
